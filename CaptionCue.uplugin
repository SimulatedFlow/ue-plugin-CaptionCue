{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "1.0.0",
	"EngineVersion": "5.8.0",
	"FriendlyName": "CaptionCue - Subtitles & Closed Captions",
	"Description": "The subtitle layer the engine never finished: speaker names in colour, closed captions for non-speech sound with on-screen direction arrows, a queue that never overwrites a line before it has been read, a minimum reading time, and the player options a console certification checklist asks for - text scale, background box, line width, safe area, position. Draws on UCanvas from AHUD, so it survives a cooked Shipping build, and bridges the engine's own subtitle stream so existing SoundWave and DialogueWave subtitles appear without a single line of change in your project. CaptionCue does not decide what is said - it decides how it reads.",
	"Category": "UI",
	"CreatedBy": "Silvan Teufel",
	"CreatedByURL": "https://silvan.teufel-engineering.com",
	"DocsURL": "https://github.com/SimulatedFlow/ue-plugin-CaptionCue",
